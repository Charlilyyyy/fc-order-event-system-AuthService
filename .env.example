PORT=3001
NODE_ENV=development
SERVICE_NAME=auth-service

DATABASE_URL=postgresql://user:password@localhost:5432/app?schema=public

# JWT (use a long random string in production, min 32 chars)
JWT_SECRET=dev-only-change-me-use-32-chars-minimum
JWT_EXPIRES_IN=1h

# Google OAuth 2.0 (free — Google Cloud Console → APIs & Services → Credentials)
# Create OAuth 2.0 Client ID (Web application)

# my google client id
# GOOGLE_CLIENT_ID=387648865674-2bgilbhhqvtls1al6kq1c6v3f6frq9d7.apps.googleusercontent.com

# google playground client id
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Email OTP (optional in dev — OTP is logged to the console when SMTP is unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OTP_EXPIRES_IN_MINUTES=15

# Forgot password — link sent to email: {FRONTEND_URL}{PASSWORD_RESET_PATH}?token=...
PASSWORD_RESET_EXPIRES_IN_MINUTES=60
PASSWORD_RESET_PATH=/reset-password